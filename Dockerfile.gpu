FROM nvidia/cuda:12.1.1-devel-ubuntu22.04
ENV HF_HOME="/app/hf_cache"
ENV SENTENCE_TRANSFORMERS_HOME="/app/hf_cache"
ENV PYTHONPATH="${PYTHONPATH}:/app"
WORKDIR /app

# 1. System Ops
RUN apt-get update && apt-get install -y \
    python3.10 python3-pip git build-essential curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3.10 /usr/bin/python

# 2. Env Vars
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
ENV CUDA_HOME="/usr/local/cuda"
ENV BNB_CUDA_VERSION=121
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 3. HEAVY LAYER (Torch 2.1.2 compatible with 4070 Ti)
RUN pip install --no-cache-dir torch==2.1.2+cu121 --extra-index-url https://download.pytorch.org/whl/cu121

# 4. REQUIREMENTS LAYER (Will re-run because requirements.txt changed)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# 5. CODE LAYER
COPY . .

# 6. Init
RUN mkdir -p models data
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]